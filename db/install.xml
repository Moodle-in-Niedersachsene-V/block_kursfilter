<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="blocks/kursfilter/db" VERSION="20260905" COMMENT="XMLDB file for block_kursfilter"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="block_kursfilter_ratings" COMMENT="Course ratings for block_kursfilter">
      <FIELDS>
        <FIELD NAME="id"          TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid"    TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="cookiehash"  TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="stars"       TYPE="int"  LENGTH="1"  NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int"  LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid"             UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="cookiehash_courseid"  UNIQUE="true"  FIELDS="cookiehash, courseid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
