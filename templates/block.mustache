{{!
    @template block_kursfilter/block

    Course filter block with category select, filter chips and search term.

    Example context (json):
    {
        "blockid": 1,
        "categories": [{"value": "", "label": "– All –"}, {"value": "2", "label": "Sprachen"}],
        "schooltypes": ["Gymnasium", "Grundschule"],
        "subjects": ["Mathematik", "Deutsch"],
        "levels": ["Oberstufe", "Klasse 10"]
    }
}}
<div class="kf-block" id="kf-block-{{blockid}}">

  <div class="mb-2">
    <label for="kf-category-{{blockid}}" class="small text-muted fw-semibold text-uppercase d-block mb-1">
      {{#str}} label_category, block_kursfilter {{/str}}
    </label>
    <select class="form-select form-select-sm" id="kf-category-{{blockid}}" data-filter="category">
      {{#categories}}
      <option value="{{value}}">{{label}}</option>
      {{/categories}}
    </select>
  </div>

  <div class="mb-2" role="group" aria-labelledby="kf-schooltype-label-{{blockid}}">
    <div id="kf-schooltype-label-{{blockid}}" class="small text-muted fw-semibold text-uppercase mb-1">
      {{#str}} label_schooltype, block_kursfilter {{/str}}
    </div>
    {{#schooltypes}}
    <button type="button" class="badge kf-chip" data-filter="schooltype" data-value="{{.}}" aria-pressed="false">{{.}}</button>
    {{/schooltypes}}
  </div>

  <div class="mb-2" role="group" aria-labelledby="kf-subject-label-{{blockid}}">
    <div id="kf-subject-label-{{blockid}}" class="small text-muted fw-semibold text-uppercase mb-1">
      {{#str}} label_subject, block_kursfilter {{/str}}
    </div>
    {{#subjects}}
    <button type="button" class="badge kf-chip" data-filter="subject" data-value="{{.}}" aria-pressed="false">{{.}}</button>
    {{/subjects}}
  </div>

  <div class="mb-2" role="group" aria-labelledby="kf-level-label-{{blockid}}">
    <div id="kf-level-label-{{blockid}}" class="small text-muted fw-semibold text-uppercase mb-1">
      {{#str}} label_level, block_kursfilter {{/str}}
    </div>
    {{#levels}}
    <button type="button" class="badge kf-chip" data-filter="level" data-value="{{.}}" aria-pressed="false">{{.}}</button>
    {{/levels}}
  </div>

  <div class="mb-3">
    <label for="kf-searchterm-{{blockid}}" class="small text-muted fw-semibold text-uppercase d-block mb-1">
      {{#str}} label_searchterm, block_kursfilter {{/str}}
    </label>
    <div class="input-group input-group-sm">
      <span class="input-group-text"><i class="fa fa-search" aria-hidden="true"></i></span>
      <input type="text"
             class="form-control"
             id="kf-searchterm-{{blockid}}"
             data-filter="searchterm"
             placeholder="{{#str}} placeholder_searchterm, block_kursfilter {{/str}}"
             autocomplete="off">
    </div>
  </div>

  <hr class="my-2">

  <div class="d-flex justify-content-between align-items-center mb-1">
    <small class="text-muted" data-region="count" aria-live="polite">–</small>
    <button type="button" class="btn btn-link btn-sm p-0 text-muted small" data-action="reset">
      {{#str}} btn_reset, block_kursfilter {{/str}}
    </button>
  </div>

  <div class="kf-results" data-region="results">
    <div class="text-center text-muted small py-3">
      {{#str}} hint_setfilter, block_kursfilter {{/str}}
    </div>
  </div>

  <div class="kf-spinner text-center py-2 d-none" data-region="spinner">
    <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
  </div>

</div>
